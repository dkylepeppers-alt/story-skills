{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dkylepeppers-alt/story-skills/schemas/issue.schema.json",
  "title": "Story Toolkit issue record (issues/)",
  "$comment": "Dismissals reference exact diagnostic codes/records and a reason, never broad substring exemptions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schema-version",
    "id",
    "type",
    "category",
    "severity",
    "status"
  ],
  "properties": {
    "format": {
      "const": "story-toolkit"
    },
    "schema-version": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "type": {
      "const": "issue"
    },
    "category": {
      "type": "string"
    },
    "severity": {
      "enum": [
        "info",
        "warning",
        "error"
      ]
    },
    "status": {
      "enum": [
        "open",
        "resolved",
        "dismissed"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source-ref"
      }
    },
    "affected-ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dismissal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "record-id": {
          "type": "string"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "extensions": {
      "type": "object"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "source-ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "hash",
        "kind"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "scene": {
          "type": "string"
        },
        "beat": {
          "type": "string"
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "kind": {
          "enum": [
            "manuscript",
            "author-decision",
            "research",
            "asset"
          ]
        }
      }
    },
    "cursor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scene",
        "side"
      ],
      "properties": {
        "scene": {
          "type": "string"
        },
        "beat": {
          "type": "string"
        },
        "side": {
          "enum": [
            "before",
            "after"
          ]
        }
      }
    },
    "cursor-or-baseline": {
      "oneOf": [
        {
          "type": "string",
          "const": "baseline"
        },
        {
          "$ref": "#/$defs/cursor"
        }
      ]
    }
  }
}
