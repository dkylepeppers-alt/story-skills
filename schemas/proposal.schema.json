{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dkylepeppers-alt/story-skills/schemas/proposal.schema.json",
  "title": "Story Toolkit reconciliation proposal",
  "$comment": "Proposals carry expected hashes for every evidence/precondition dependency and a rationale/source mapping per factual change. They cannot weaken or redefine caller-supplied scope restrictions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schema-version",
    "id",
    "type",
    "operation"
  ],
  "properties": {
    "format": {
      "const": "story-toolkit"
    },
    "schema-version": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "type": {
      "const": "proposal"
    },
    "operation": {
      "enum": [
        "working-edit",
        "adoption",
        "retcon"
      ]
    },
    "expected-hashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "writes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "action"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "action": {
            "enum": [
              "create",
              "replace",
              "remove"
            ]
          },
          "expected-hash": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "content": {
            "type": "string"
          }
        }
      }
    },
    "affected-ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/source-ref"
            }
          }
        }
      }
    },
    "extensions": {
      "type": "object"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "source-ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "hash",
        "kind"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "scene": {
          "type": "string"
        },
        "beat": {
          "type": "string"
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "kind": {
          "enum": [
            "manuscript",
            "author-decision",
            "research",
            "asset"
          ]
        }
      }
    },
    "cursor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scene",
        "side"
      ],
      "properties": {
        "scene": {
          "type": "string"
        },
        "beat": {
          "type": "string"
        },
        "side": {
          "enum": [
            "before",
            "after"
          ]
        }
      }
    },
    "cursor-or-baseline": {
      "oneOf": [
        {
          "type": "string",
          "const": "baseline"
        },
        {
          "$ref": "#/$defs/cursor"
        }
      ]
    }
  }
}
