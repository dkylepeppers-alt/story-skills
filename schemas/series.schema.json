{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dkylepeppers-alt/story-skills/schemas/series.schema.json",
  "title": "Story Toolkit series record (series.md)",
  "$comment": "Series share explicit identities scoped by series id, not filename coincidences; reading order can differ from story chronology.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schema-version",
    "id",
    "type"
  ],
  "properties": {
    "format": {
      "const": "story-toolkit"
    },
    "schema-version": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "type": {
      "const": "series"
    },
    "title": {
      "type": "string"
    },
    "books": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "order": {
            "type": "integer"
          }
        }
      }
    },
    "shared-identities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "books": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "shared-facts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "extensions": {
      "type": "object"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "source-ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "hash",
        "kind"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "scene": {
          "type": "string"
        },
        "beat": {
          "type": "string"
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "kind": {
          "enum": [
            "manuscript",
            "author-decision",
            "research",
            "asset"
          ]
        }
      }
    },
    "cursor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scene",
        "side"
      ],
      "properties": {
        "scene": {
          "type": "string"
        },
        "beat": {
          "type": "string"
        },
        "side": {
          "enum": [
            "before",
            "after"
          ]
        }
      }
    },
    "cursor-or-baseline": {
      "oneOf": [
        {
          "type": "string",
          "const": "baseline"
        },
        {
          "$ref": "#/$defs/cursor"
        }
      ]
    }
  }
}
