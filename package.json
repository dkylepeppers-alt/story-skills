{
  "name": "@dkylepeppers-alt/story-toolkit",
  "version": "1.0.0-rc.0",
  "description": "The Story Toolkit: agent skills and a companion story CLI for planning, drafting, revising, and publishing fiction in markdown.",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "story": "./bin/story.js"
  },
  "files": [
    "bin",
    "docs",
    "licenses",
    "provenance",
    "schemas",
    "src",
    "skills",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build:fallback": "bun build ./bin/story.js --target=node --outfile=skills/story-maintenance/scripts/story.js",
    "check:metadata": "node scripts/check-metadata.js",
    "check:fallback": "node scripts/check-fallback.js",
    "check:evals": "node scripts/check-evals.js",
    "check:node-help": "node skills/story-maintenance/scripts/story.js --help",
    "release": "node scripts/release.js",
    "test:examples": "node scripts/check-examples.js",
    "eval:selftest": "node evals/run-evals.js --all evals/examples",
    "story": "bun run ./bin/story.js",
    "test": "bun test ./test/*.test.js",
    "test:coverage": "bun test ./test/*.test.js --coverage --coverage-reporter=lcov --coverage-dir=coverage && node scripts/check-coverage.js coverage/lcov.info src && bun run check:fallback"
  },
  "keywords": [
    "story",
    "writing",
    "fiction",
    "characters",
    "worldbuilding",
    "chapters",
    "revision",
    "agent-skills"
  ],
  "author": {
    "name": "Daniel Dewhurst",
    "url": "https://github.com/danjdewhurst"
  },
  "homepage": "https://github.com/dkylepeppers-alt/story-skills",
  "bugs": "https://github.com/dkylepeppers-alt/story-skills/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dkylepeppers-alt/story-skills.git"
  },
  "license": "MIT",
  "devDependencies": {},
  "dependencies": {
    "ajv": "^8.20.0",
    "yaml": "^2.9.1"
  }
}
